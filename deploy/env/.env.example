# 复制为 deploy/.env 后按需修改：
#   copy env\.env.example .env
# docker compose 只读取与 compose 文件同级的 .env，本文件仅作模板。

# MySQL 8.0
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=yszx_root
MYSQL_DATABASE=yszx
MYSQL_USER=yszx
MYSQL_PASSWORD=yszx_pass

# Redis 7
REDIS_PORT=6379
REDIS_PASSWORD=yszx_redis

# MinIO（API 9000，控制台 9001）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=yszx
MINIO_ROOT_PASSWORD=yszx_minio_pass
MINIO_BUCKET=yszx
